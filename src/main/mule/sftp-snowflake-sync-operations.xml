<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:tracing="http://www.mulesoft.org/schema/mule/tracing" xmlns:validation="http://www.mulesoft.org/schema/mule/validation"
	xmlns:sftp="http://www.mulesoft.org/schema/mule/sftp"
	xmlns:batch="http://www.mulesoft.org/schema/mule/batch" xmlns:file="http://www.mulesoft.org/schema/mule/file" xmlns:snowflake="http://www.mulesoft.org/schema/mule/snowflake" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/snowflake http://www.mulesoft.org/schema/mule/snowflake/current/mule-snowflake.xsd
http://www.mulesoft.org/schema/mule/file http://www.mulesoft.org/schema/mule/file/current/mule-file.xsd
http://www.mulesoft.org/schema/mule/batch http://www.mulesoft.org/schema/mule/batch/current/mule-batch.xsd
http://www.mulesoft.org/schema/mule/sftp http://www.mulesoft.org/schema/mule/sftp/current/mule-sftp.xsd
http://www.mulesoft.org/schema/mule/validation http://www.mulesoft.org/schema/mule/validation/current/mule-validation.xsd
http://www.mulesoft.org/schema/mule/tracing http://www.mulesoft.org/schema/mule/tracing/current/mule-tracing.xsd">
	<flow name="egnyte-sftp-to-snowflake-sync-flow" doc:id="a74122cf-e603-4462-8c3f-11d96391b126" >
		<scheduler doc:name="sync " doc:id="cac062a2-91a3-453c-95f3-c2a25c5ffcef" >
			<scheduling-strategy >
				<cron expression="${scheduler.cron.expression}" timeZone="${scheduler.cron.timezone}" />
			</scheduling-strategy>
		</scheduler>
		<logger level="INFO" doc:name="START" doc:id="0add66ab-b59a-4ba5-9b52-795caf3c8849" message='#["START: Scheduler for Files Sync from SFTP to Snowflake"]' />
		<sftp:list doc:name="List all files" doc:id="a4784225-8671-4d4e-999e-6d6431a0565b" config-ref="fidelity_SFTP_Config" directoryPath="#[p('fidelity.directory.path')]" />
		<logger level="INFO" doc:name="Log File Count" doc:id="f62cdbc0-6cc3-4976-aa7f-48d3b8ee30d6" message='#["Listed all files on SFTP : " ++ sizeOf(payload) default 0]'/>
		<parallel-foreach doc:name="Parallel For Each" doc:id="dde101a6-7e76-4606-b33a-3a6b84387522" maxConcurrency="${file.maxconcurrency}" collection="#[payload]">
			<set-variable value='#[attributes.fileName]' doc:name="fileName" doc:id="66c48162-f07e-4e87-a404-d703ae25c06f" variableName="fileName" />
			<tracing:with-correlation-id doc:name="With CorrelationID" doc:id="55c8ff8a-3866-4e1b-a484-3bfd2187298e" correlationId='#[correlationId ++ "-" ++ vars.fileName]'>
				<logger level="INFO" doc:name="Log File Processing" doc:id="96fefa9b-a036-4d3d-b52e-5ce1a1151078" message='#[vars.fileName ++ ": File Processing Started"]' />
				<try doc:name="Try" doc:id="b0c2f678-da6a-44a6-8829-abf94f5dd404">
				<sftp:read doc:name="Read file" doc:id="e2308e25-f076-49fe-adf3-0d6e95565a7d" config-ref="fidelity_SFTP_Config" path='#["/Shared/FidelitySFTP/Transmissions/Inbound/" ++ vars.fileName]' />
				<logger level="INFO" doc:name="After File Read" doc:id="982691ad-b1c0-4512-941c-4ee42407d6fd" message='#[vars.fileName ++ ": File Read from SFTP"]' />
				<ee:transform doc:name="snowflakeTempFile" doc:id="e07cee07-05a8-4c72-a274-926ca7d4342c">
				<ee:message />
				<ee:variables>
						<ee:set-variable variableName="snowflakeTempFile"><![CDATA[%dw 2.0
output application/json
---
(Mule::p('app.home') ++ '/temp/' ++ correlationId ++ "_" ++  vars.fileName) replace "\\" with "/"

]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
					<file:write doc:name="Write to temp directory" doc:id="681625bc-be92-4fd7-89c3-56f9c86207ca" config-ref="File_Config" path="#[vars.snowflakeTempFile]" />
				<snowflake:execute-script doc:name="Upload to snowflake" doc:id="f3e43362-9879-4f61-899d-d9d07b8b0708" config-ref="Snowflake_Config">
				<snowflake:sql><![CDATA[#["PUT 'file://" ++ (vars.snowflakeTempFile default "") ++ "' @STG_FIDELITY AUTO_COMPRESS=FALSE;"]]]></snowflake:sql>
			</snowflake:execute-script>
				<logger level="INFO" doc:name="Log Uploaded File" doc:id="8ef60d26-e23f-426b-a55d-315e968d24bc" message='#[vars.fileName ++ ": File Uploaded to Snowflake"]' />
				<file:delete doc:name="Delete from temp directory" doc:id="9d1e28de-438f-4800-91d7-ff628b9be52c" config-ref="File_Config" path="#[vars.snowflakeTempFile]" />
				<sftp:move doc:name="Archive File" doc:id="6864c13c-8c9a-4fdc-8029-9a3a5f861990" config-ref="fidelity_SFTP_Config" sourcePath='#["/Shared/FidelitySFTP/Transmissions/Inbound/" ++ vars.fileName]' targetPath='#["/Shared/FidelitySFTP/Transmissions/Archive/"]' createParentDirectories="false" renameTo='#[now() as String {format: "yyyyMMddHHmmss_"} ++ vars.fileName]'/>
				<logger level="INFO" doc:name="Log Archive File" doc:id="5acc9206-31cf-4849-8827-4fee0c5a057b" message='#[vars.fileName ++ ": File Moved to Archive Folder"]' />
				<error-handler>
					<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="1a837ccd-01be-4b50-917f-1145ee1162c1" type="ANY">
						<logger level="ERROR" doc:name="Error Log" doc:id="b8fc0042-8dd1-4f4b-ae27-aad68e8e4f61" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;	"message": "Error Occured while syncing file from SFTP to Snowflake",&#10;	"errorType": error.errorType.namespace ++ ":" ++ error.errorType.identifier,&#10;	"errorDescription": error.description,&#10;	"correlationId": correlationId,&#10;	"fileName": vars.fileName&#10;}]' />
						<sftp:move doc:name="Move to Error Folder" doc:id="e19183a0-2410-49af-a3f4-7b9c648a0633" config-ref="fidelity_SFTP_Config" sourcePath='#["/Shared/FidelitySFTP/Transmissions/Inbound/" ++ vars.fileName]' targetPath='#["/Shared/FidelitySFTP/Transmissions/Error/"]' createParentDirectories="false" renameTo='#[now() as String {format: "yyyyMMddHHmmss_"} ++ vars.fileName]'/>
							<logger level="ERROR" doc:name="Log File Moved to Archive" doc:id="cecaedc6-8b48-4513-978e-2cf1f62ee9ea" message='#[vars.fileName ++ ": File Moved to Error Folder"]'/>
					</on-error-continue>
				</error-handler>
			</try>
			</tracing:with-correlation-id>
		</parallel-foreach>
		<logger level="INFO" doc:name="END" doc:id="ecb3a2d6-4f96-4861-984c-e0c13be2eeac" message='#["END: Scheduler for Files Sync from SFTP to Snowflake"]'/>
		<error-handler >
			<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="7a7b2bf6-b19f-476f-be47-af7eb5b8ad95" type="ANY">
				<logger level="ERROR" doc:name="Log Error" doc:id="570d4721-5a5f-4c01-abd0-1fcb09597d42" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;	"message": "Error Occured while Listing all files on SFTP",&#10;	"errorType": error.errorType,&#10;	"errorDescription": error.errorDescription,&#10;	"correlationId": correlationId&#10;}]' />
			</on-error-propagate>
		</error-handler>
	</flow>

</mule>
